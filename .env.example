# DeepSeek API（文字分析）
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 火山方舟豆包（图像多模态，可选）
# 不配置 VISION_MODEL 则图片仅记录元数据（尺寸/格式），不识别内容。
VISION_MODEL=doubao-seed-1-6-250615
VISION_API_KEY=ark-your-volcengine-api-key
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 语言设置
APP_LANGUAGE=zh

# Agent API 认证（可选）
# 设置后，外部 Agent 调用 /agent/v1/ 需在 Header 中传 X-API-Key
DOCGRAPH_AGENT_KEY=
